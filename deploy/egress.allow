# Where the tokumai enclave may connect, through tokumai-egress-host. One rule per line:
# a host name (or .suffix for it and every subdomain) and its ports.

# Nym: the API (topology, the node directory) and the gateways (WebSocket, 9000 plain / 9001 TLS)
.nymtech.net 443
.nymtech.cc 443
.nym.com 443

# Model providers
api.openai.com 443
generativelanguage.googleapis.com 443

# AWS KMS: where the enclave has its sealed secrets opened — for its own image only.
kms.eu-central-1.amazonaws.com 443
# The witness of the book (crates/enclave/src/witness.rs): the bucket named in the image.
tokumai-book-946944821363.s3.eu-central-1.amazonaws.com 443

# Payments
api.stripe.com 443
api.storekit.itunes.apple.com 443
api.storekit-sandbox.itunes.apple.com 443

# The enclave's own gateway — one of the operator's own (TOKUMAI_GATEWAY in the image),
# with its siblings, so moving the enclave to another of them needs no new allowlist.
nym-exit-de01.hermes-stakepool.de 9000,9001   # DE01, the one pinned in the image
nym-exit-at01.hermes-stakepool.de 9000,9001   # AT01
nym-exit-ch01.hermes-stakepool.de 9000,9001   # CH01
nym-exit-de02.hermes-stakepool.de 9000,9001   # DE02
152.53.135.191 9000,9001
152.53.92.255 9000,9001
141.227.148.103 9000,9001
152.53.137.91 9000,9001
