# Copy this file to `.env` and fill in what you have.
# `.env` is gitignored — real keys never enter version control.
#
# The server needs AT LEAST ONE provider. Each is optional: a provider whose
# credential is missing is simply not offered, and the server says which ones
# it skipped on startup.
#
# Values with spaces (the mnemonic) MUST be double-quoted: an unquoted value with
# spaces is a parse error, and everything BELOW that line is silently not loaded.

# Pin the mixnet entry gateway (identity key). Leave unset to let the SDK choose.
SCRAI_GATEWAY=<entry gateway identity>
# 1-of-1 Coconut authority (single-server deployment). Without it the server refuses to boot.
SCRAI_ALLOW_SINGLE_AUTHORITY=1

# Providers to offer, comma-separated. Only providers listed here AND credentialed below run.
SCRAI_PROVIDERS=gemini

# Day boundary for scrai-admin's DAILY table — set it to the provider's billing zone so
# the numbers reconcile (Google AI Studio buckets in Pacific time).
SCRAI_METRICS_TZ=Europe/Berlin
# scrai-admin shows provider cost in € next to $ at this rate (Google's AI Studio dashboard
# and invoice are EUR at Google's own monthly rate — copy it from the invoice, update monthly).
# Unset → dollars only.
SCRAI_FX_EUR_PER_USD=0.857

# --- Release gate ------------------------------------------------------------
# Refuse every request from an app older than this (0.2.x sends no version → refused too).
# Old clients see "Update required — … Download: <SCRAI_UPDATE_URL>" (in the model header
# and on every action); 0.3.0+ shows a blocking Update sheet. Set it only AFTER the new
# builds are on the download site. Unset → no gate.
# SCRAI_MIN_APP=0.3.0
# SCRAI_UPDATE_URL=https://scrai-faucet.hermes-stakepool.de/
# Developer servers only: send the provider's cost per answer to the app (the margin!).
# Never on a server testers or customers talk to.
# SCRAI_DEV_AUDIT=1

# --- Testnet faucet ---------------------------------------------------------
# SCRAI_TESTNET=1 is the kill switch for the whole tester flow: the server accepts $1
# invoices flagged `testnet:true`, the app shows the "Testnet purchase" toggle, and
# scrai-faucet.service pays those invoices. Unset/0 → all three off, no client update needed.
SCRAI_TESTNET=1
# A dedicated account on the SAME chain the server watches (NYX_LCD_URL_* below);
# on the sandbox it holds sandbox NYM. Never the operator's main wallet.
SCRAI_FAUCET_MNEMONIC="<mnemonic for faucet payments>"
# The faucet wallet's ADDRESS (the account above). The server credits a testnet invoice
# ONLY when the NYM came from this address — sandbox NYM is free from Nym's public
# faucet, so without the pin anyone could self-fund $1 credits without an invite code.
# Unset on a testnet server → every purchase is refused. `scrai-faucet` prints the
# address at boot ("wallet n1…").
SCRAI_TESTNET_FAUCET_ADDRESS=n1...
# Shown in the app next to a testnet invoice's memo (https only).
SCRAI_FAUCET_URL=https://scrai-faucet.hermes-stakepool.de
# The chain RPC is derived from NYX_LCD_URL_* (`<validator>/api` → `<validator>`).
# Only set this if LCD and RPC live on different hosts:
# SCRAI_FAUCET_RPC=https://validator-sandbox-1.nymtech.net
# Optional knobs (defaults shown): claims per UTC day, unym the wallet never spends
# below, tx explorer prefix for the site, listen address (loopback — Caddy in front).
# SCRAI_FAUCET_DAILY_MAX=20
# SCRAI_FAUCET_RESERVE_UNYM=5000000
# SCRAI_FAUCET_EXPLORER=https://sandbox-explorer.nymtech.net/transaction/
# SCRAI_FAUCET_LISTEN=127.0.0.1:8790
# Downloads on the site come from scripts/publish-downloads.sh (bundles + manifest.json
# in SCRAI_SITE_DL_DIR, served by Caddy as /dl/). Only the iOS links are env:
# SCRAI_SITE_DL_DIR=/opt/scrai/site/dl
# SCRAI_DL_IOS=https://testflight.apple.com/join/<code>
# SCRAI_DL_IOS_GUIDE=https://<sideload guide>

# --- provider API keys ------------------------------------------------------
# Network-scoped: <VAR>_TESTNET / <VAR>_MAINNET. Exactly one of the two active
# (scrai-admin's `n` key flips the comment state of every managed var at once).
#
# GOOGLE / GEMINI
# GEMINI_API_KEY_TESTNET=<testnet gemini api key>
GEMINI_API_KEY_MAINNET=<mainnet gemini api key>

# --- pricing ----------------------------------------------------------------
# Markup on provider cost. Server-side only; the client never sees it.
MARGIN=1.1
MIN_CHARGE_SCRAI=1
FREE_TIER_FACTOR=1.0
# Fixed purchase amounts in USD (everyone buys the same — no per-user fingerprint).
# SCRAI_PURCHASE_TIERS=5,10,20,50

# --- payment (dev) ----------------------------------------------------------
# Invoices settle by command instead of by money. NEVER in production; the server
# refuses to boot with it set alongside real BTCPay/Nyx credentials.
# SCRAI_FAKE_PAYMENTS=1

# --- payment: BTCPay ----------------------------------------------------------
# Store ID : from the URL /stores/<HERE>/settings
# API key  : Account -> Manage account -> API keys, with exactly
#            btcpay.store.cancreateinvoice + btcpay.store.canviewinvoices
BTCPAY_URL_TESTNET=https://testnet.demo.btcpayserver.org
BTCPAY_STORE_ID_TESTNET=<testnet store id>
BTCPAY_API_KEY_TESTNET=<testnet store key>
#
# BTCPAY_URL_MAINNET=<mainnet btcpay>
# BTCPAY_STORE_ID_MAINNET=<mainnet store id>
# BTCPAY_API_KEY_MAINNET=<mainnet store key>

# Mollie Creditcard payments
#
# Hosted checkout (no card data ever reaches us); the server polls Mollie on the
# client's status poll — no webhook, no inbound port. See docs/card-payments.md.
# API key: Mollie Dashboard -> Developers -> API keys. A test_… key is Mollie's
# test mode: EUR only (the tile's number is charged 1:1 in EUR as a placeholder)
# and the hosted page lets you pick the outcome. live_… moves real money.
# Cards sell the larger tiles only — SCRAI_CARD_MIN_USD (default 10): the fixed
# €0.25 fee eats a third of a $1 tile, and a card payment can be charged back for
# weeks after the credit is withdrawn as unlinkable ecash. No key = no card row.
MOLLIE_API_KEY_TESTNET=<mollie test api key, test_…>
#MOLLIE_API_KEY_MAINNET=<mollie live api key, live_…>
# Where Mollie sends the browser afterwards (static "payment received" page, no
# order id). Default: <SCRAI_FAUCET_URL>/paid, else https://scrai-faucet.hermes-stakepool.de/paid
#MOLLIE_REDIRECT_URL=https://scrai-faucet.hermes-stakepool.de/paid
#SCRAI_CARD_MIN_USD=10

# --- payment: NYM / NYX -------------------------------------------------------
# TESTNET / sandbox (active) — chain "sandbox", denom unym
# MAINNET (commented out) — chain "nyx"
# The LCD is the validator's /api; the faucet uses the same validator's root as RPC.
NYX_LCD_URL_TESTNET=https://validator-sandbox-1.nymtech.net/api
NYX_RECEIVE_ADDRESS_TESTNET=<sandbox nyx address>
# NYX_LCD_URL_MAINNET=https://api.nymtech.net
# NYX_RECEIVE_ADDRESS_MAINNET=<mainnet nyx address>
# Own price feed instead of the built-in chain (tests): NYX_PRICE_URL=<url>
