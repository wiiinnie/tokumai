# Copy this file to `.env` and fill in what you have.
# `.env` is gitignored — real keys never enter version control.
#
# The server needs AT LEAST ONE provider. Each is optional: a provider whose
# credential is missing is simply not offered, and the server says which ones
# it skipped on startup.

# --- text ---------------------------------------------------------------
# aistudio.google.com/apikey — free tier for text. Image models need billing.
# --- Gemini keys: EXACTLY ONE active (the server refuses to boot with both) --
# testnet = free-tier project (no billing linked), mainnet = paid project.
# Flip between them by (un)commenting; never leave both uncommented.
GEMINI_API_KEY_TESTNET=
#GEMINI_API_KEY_MAINNET=

# Optional catalog allowlist, e.g. "gemini" or "gemini,groq"; unset/"all" = everything.
#SCRAI_PROVIDERS=gemini

# console.groq.com/keys — free tier: llama-3.3-70b 1k req/day,
# llama-3.1-8b 14.4k req/day.
GROQ_API_KEY=

# --- images -------------------------------------------------------------
# dash.cloudflare.com — free allowance of 10,000 Neurons/day, covers FLUX.
# The token needs the "Workers AI" permission. Both values are required.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Pollinations needs no key at all and is always available (free, but weak,
# and it is a third party with no contract — see the README).

# --- pricing ------------------------------------------------------------
# Markup on provider cost. Server-side only; the client never sees it.
MARGIN=1.1
MIN_CHARGE_SCRAI=0

# Output caps that make the price ceiling a true upper bound. The server reserves
# exactly this much output per request AND enforces it at the provider, so it can
# never pay for more tokens than it reserved. Both enlarge the reservation when
# raised: the answer cap for longer replies, the thinking cap for deeper
# reasoning (0 turns thinking off).
# SCRAI_DEFAULT_MAX_TOKENS=4096   # answer cap applied when the client sends none
# SCRAI_THINKING_BUDGET=2048      # thinking-token cap (billed as output on Gemini)

# --- payment: BTCPay ---
# From YOUR BTCPay instance — they do not exist beforehand.
#   Store ID : visible in the URL,  /stores/<THIS>/settings
#   API key  : Account -> Manage account -> API keys -> Generate Key
#              Grant exactly two permissions and nothing else:
#                btcpay.store.cancreateinvoice
#                btcpay.store.canviewinvoices
#              With no permissions selected the key gets UNRESTRICTED access.
#              Neither permission can move funds, so a leaked key cannot spend.
#
# To try it without deploying anything, use the public testnet demo and fund it
# from a testnet faucet — real flow, worthless coins:
#   BTCPAY_URL=https://testnet.demo.btcpayserver.org
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=

# --- payment ---
# SCRAI_REQUIRE_PAYMENT=0   # disable enforcement (every request free)
# SCRAI_DEV_MINT=1          # dev only: mint funding tokens without payment
# SCRAI_MONEY_DB=./data/money.db

# Fixed purchase amounts (USD). Everyone buys the SAME amounts, so a purchase is
# one of a few shared buckets rather than a per-user fingerprint — at the invoice,
# the withdrawal, and the denomination set of a redemption. Enforced server-side.
# SCRAI_PURCHASE_TIERS=5,10,20,50

# --- ecash mint key ---
# The whole blind-signature keyset is derived from this seed. SET IT in
# production: then the database never holds a minting secret, and the keyset is
# stable across restarts and across a horizontally-scaled deployment. Leave it
# unset only in dev, where a random seed is generated once and persisted in the
# DB. Anyone who learns this value can mint unlimited SCRAI — treat it like a
# signing key: long, random, backed up, never committed.
# SCRAI_ISSUER_SECRET=change-me-to-a-long-random-string

# Day boundary for the per-day metrics (scrai-admin DAILY table). Pick the zone your
# provider's billing view uses so the two agree per day: Google Cloud Billing reports use
# America/Los_Angeles; the AI Studio dashboard buckets by your browser's local time.
# UTC (default) · Europe/Berlin · America/Los_Angeles · or a fixed offset like +02:00
# SCRAI_METRICS_TZ=Europe/Berlin

# ── Testnet faucet (tester onboarding) ───────────────────────────────────────
# SCRAI_TESTNET=1 is THE kill switch for the whole feature: with it the server accepts
# `testnet:true` $1 invoices and advertises the "Testnet purchase" toggle to every
# client; without it (unset/0) the toggle never renders, old clients that still send
# the flag are refused, and deploy.sh disables scrai-faucet.service. See docs/faucet.md.
# SCRAI_TESTNET=1
# Shown in the app next to the memo of a testnet invoice (https only).
# SCRAI_FAUCET_URL=https://scrai-faucet.hermes-stakepool.de
# scrai-faucet (same .env): the wallet that pays testers' $1 invoices — a dedicated
# account on the SAME chain the server watches (NYX_LCD_URL_*): on the Nym sandbox that
# is sandbox NYM (free from the sandbox faucet), on Nyx mainnet it would be real NYM.
# Never the operator's main wallet. Payments go to NYX_RECEIVE_ADDRESS with the memo.
# SCRAI_FAUCET_MNEMONIC="word1 word2 … word24"     # QUOTES REQUIRED — an unquoted value with spaces breaks .env parsing from that line on
# Tendermint RPC of that chain's node — the ROOT of the validator URL (its LCD is /api):
# SCRAI_FAUCET_RPC=https://validator-sandbox-1.nymtech.net   # sandbox; mainnet: https://rpc.nymtech.net
# SCRAI_FAUCET_LISTEN=127.0.0.1:8790                      # loopback; Caddy terminates TLS in front
# SCRAI_FAUCET_DAILY_MAX=20                               # claims per UTC day
# SCRAI_FAUCET_RESERVE_UNYM=5000000                       # never spend below 5 NYM
# SCRAI_FAUCET_EXPLORER=https://sandbox-explorer.nymtech.net/transaction/   # + tx hash, optional (mainnet: https://www.mintscan.io/nyx/tx/)
# Downloads: macOS/Linux bundles come from scripts/publish-downloads.sh, which uploads
# them to SCRAI_SITE_DL_DIR (default /opt/scrai/site/dl, served by Caddy as /dl/) together
# with manifest.json (version, sha256, sizes) — the site reads that on every view, so a
# new upload is live at once. Only the iOS links are env (they live elsewhere).
# SCRAI_SITE_DL_DIR=/opt/scrai/site/dl
# SCRAI_DL_IOS=https://testflight.apple.com/join/…
# SCRAI_DL_IOS_GUIDE=https://…/sideload.html
