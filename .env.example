# tokumai server configuration.
#
# The SCRAI_ prefix was dropped on 2026-09-05 (ALLOW_SINGLE_AUTHORITY, not
# SCRAI_ALLOW_SINGLE_AUTHORITY). The server still reads the OLD name as a fallback, so an
# un-migrated .env keeps working — several of these are fail-closed and a half-done rename
# would otherwise stop the box. Rename at leisure, then the fallback (server/src/lib.rs,
# `cfg`) can go.
#
# Copy this file to `.env` and fill in what you have.
# `.env` is gitignored — real keys never enter version control.
#
# The server needs AT LEAST ONE provider. Each is optional: a provider whose
# credential is missing is simply not offered, and the server says which ones
# it skipped on startup.
#
# Values with spaces (the mnemonic) MUST be double-quoted: an unquoted value with
# spaces is a parse error, and everything BELOW that line is silently not loaded.

# Pin the mixnet entry gateway (identity key). Leave unset to let the SDK choose.
# Entry gateway of the primary identity (the address the app ships with). Applied on every
# start: changing it moves the identity (same keys, new @gateway in the address).
GATEWAY_MASTER=<entry gateway identity>
# Extra identities of the SAME server on other gateways — the app learns them from the
# catalog reply and falls back to them when the master's gateway is down. One identity
# per entry (data/.nym-server-1, -2, …); leave unset for a single identity.
# GATEWAY_FALLBACK=<gateway identity>,<gateway identity>
# 1-of-1 Coconut authority (single-server deployment). Without it the server refuses to boot.
ALLOW_SINGLE_AUTHORITY=1

# Providers to offer, comma-separated: "gemini", "openai" (or "all"). Only providers
# listed here AND credentialed below run — and since 2026-09-04 the list is enforced on
# the CHAT path too, not just in the model picker, so switching one off really switches
# it off. Anything else is unroutable and refused.
PROVIDERS=gemini

# Day boundary for scrai-admin's DAILY table — set it to the provider's billing zone so
# the numbers reconcile (Google AI Studio buckets in Pacific time).
METRICS_TZ=Europe/Berlin
# scrai-admin shows provider cost in € next to $ at this rate (Google's AI Studio dashboard
# and invoice are EUR at Google's own monthly rate — copy it from the invoice, update monthly).
# Unset → dollars only.
FX_EUR_PER_USD=0.857

# --- Release gate ------------------------------------------------------------
# Refuse every request from an app older than this (0.2.x sends no version → refused too).
# Old clients see "Update required — … Download: <UPDATE_URL>" (in the model header
# and on every action); 0.3.0+ shows a blocking Update sheet. Set it only AFTER the new
# builds are on the download site. Unset → no gate.
# MIN_APP=0.3.0
# UPDATE_URL=https://tokumai.com/
# Refuse a purchase whose two § 356 (5) BGB confirmations are missing, instead of only
# recording them. The app has enforced them since 0.5.8; every build BEFORE that sends
# none, so switching this on alone stops every installed app from buying.
# Set it together with MIN_APP >= 0.5.8, never before, and only once 0.5.8 is on the
# download site AND in TestFlight. The wording those buyers agreed to is versioned in
# docs/consent/.
# REQUIRE_CONSENT=1
# The key the voucher fingerprint is computed under. REQUIRED for selling codes on the
# website — without it those purchases are refused (existing codes still redeem).
#
# Why it exists: a code is 12 characters from a 32-symbol alphabet, and the `vouchers`
# table stores only its fingerprint. Unkeyed, that is a 2^60 search someone holding a
# BACKUP of state.db can finish in a couple of months on a few GPUs — and one search
# recovers every unredeemed code at once, because each candidate is tested against the
# whole table. Under a key that attack needs the key, which is here and not in the
# database. Keep it OUT of the same backup as state.db, and never rotate it while
# unredeemed codes exist — they would all stop verifying.
#
# At least 32 characters. Generate one yourself, e.g.:  openssl rand -hex 32
# VOUCHER_KEY=

# How often the app moves one $1 book from the coins on a device onto its session balance
# while it is open. Minutes; default 5. The same cadence for everyone is what keeps one
# session from standing out — raise it as the user base grows, never per user.
# TRICKLE_MINUTES=5
# The label and hint on the app's code field. Neutral by default. On iOS this wording is an
# App Review question (it must not point at the purchase outside the store); put App
# Review's answer here rather than in a build.
# REDEEM_LABEL=Have a code?
# REDEEM_HINT=Enter it here.

# How many days a settled purchase keeps the buyer's account on it, and a voucher its
# purchase. That link is what lets support answer "I paid and got nothing" and judge a
# goodwill refund; after it, an invoice is an amount and a date, a voucher is a code.
# Default 7 — a Friday purchase, a Monday ticket, a Tuesday reply. Chargebacks arrive
# after 30–120 days and were never covered by any window. Floor 1.
# ACCOUNT_LINK_DAYS=7

# App Store purchases (iOS, StoreKit 2). The app sends Apple's signed transaction; the
# server verifies it against the Apple root pinned in the binary — no Apple API key.
# Product ids are <IAP_PRODUCT_PREFIX><tile>; IAP_TIERS must be purchase tiers (same
# buckets as every other rail, so an iPhone buyer is not recognisable by amount).
# IAP_PRODUCT_PREFIX=com.tokumai.app.credit.
# IAP_TIERS=10,20,50
# IAP_BUNDLE_ID=com.tokumai.app
# Sandbox (TestFlight / Xcode) transactions credit real entitlement ONLY with this set.
# Never on the production server.
# IAP_ALLOW_SANDBOX=0

# The operator console's port (tokumai-admin, a page on loopback). Default 8791.
#
# The PORT only — the address is not configurable and never will be. That binary always
# binds 127.0.0.1, because the box it runs on holds authority.json (the Coconut issuer key:
# whoever reaches it can mint unlimited valid credit). An ADMIN_LISTEN=0.0.0.0 typed in a
# hurry is exactly how that would end up answering the internet, so there is no such knob.
# Reach it through the SSH session that starts it:
#   ssh -t -L 8791:127.0.0.1:8791 <admin>@<host> sudo -u scrai /opt/tokumai/bin/tokumai-admin
# ADMIN_PORT=8791

# Developer servers only: send the provider's cost per answer to the app (the margin!).
# Never on a server testers or customers talk to.
# DEV_AUDIT=1

# --- Testnet faucet ---------------------------------------------------------
# TESTNET=1 is the kill switch for the whole tester flow: the server accepts $1
# invoices flagged `testnet:true`, the app shows the "Testnet purchase" toggle, and
# scrai-faucet.service pays those invoices. Unset/0 → all three off, no client update needed.
TESTNET=1
# A dedicated account on the SAME chain the server watches (NYX_LCD_URL_* below);
# on the sandbox it holds sandbox NYM. Never the operator's main wallet.
FAUCET_MNEMONIC="<mnemonic for faucet payments>"
# The faucet wallet's ADDRESS (the account above). The server credits a testnet invoice
# ONLY when the NYM came from this address — sandbox NYM is free from Nym's public
# faucet, so without the pin anyone could self-fund $1 credits without an invite code.
# Unset on a testnet server → every purchase is refused. `scrai-faucet` prints the
# address at boot ("wallet n1…").
TESTNET_FAUCET_ADDRESS=n1...
# Shown in the app next to a testnet invoice's memo (https only).
FAUCET_URL=https://faucet.tokumai.com
# Our website, for the /pay hand-over link the app builds (a purchase raised in the app is
# paid in the browser — Apple's IAP gate). Unlike FAUCET_URL this is NOT testnet-only;
# on mainnet it is the one that matters. Falls back to FAUCET_URL when unset.
SITE_URL=https://tokumai.com
# The chain RPC is derived from NYX_LCD_URL_* (`<validator>/api` → `<validator>`).
# Only set this if LCD and RPC live on different hosts:
# FAUCET_RPC=https://validator-sandbox-1.nymtech.net
# Optional knobs (defaults shown): claims per UTC day, unym the wallet never spends
# below, tx explorer prefix for the site, listen address (loopback — Caddy in front).
# FAUCET_DAILY_MAX=20
# FAUCET_RESERVE_UNYM=5000000
# FAUCET_EXPLORER=https://sandbox-explorer.nymtech.net/transaction/
# FAUCET_LISTEN=127.0.0.1:8790
# Downloads on the site come from scripts/publish-downloads.sh (bundles + manifest.json
# in SITE_DL_DIR, served by Caddy as /dl/). Only the iOS links are env:
# SITE_DL_DIR=/opt/scrai/site/dl
# DL_IOS=https://testflight.apple.com/join/<code>
# DL_IOS_GUIDE=https://<sideload guide>

# --- provider API keys ------------------------------------------------------
# Network-scoped: <VAR>_TESTNET / <VAR>_MAINNET. Exactly one of the two active
# (scrai-admin's `n` key flips the comment state of every managed var at once).
#
# GOOGLE / GEMINI
# GEMINI_API_KEY_TESTNET=<testnet gemini api key>
GEMINI_API_KEY_MAINNET=<mainnet gemini api key>

# --- pricing ----------------------------------------------------------------
# Markup on provider cost. Server-side only; the client never sees it.
# 1.30 since 2026-09-09 (1.15 was not profitable on any rail; on IAP it was negative,
# since Apple's cut is on the sale price). Before that 1.15 since 2026-08-29: the same
# price for every rail (no card surcharge, which
# §270a BGB / PSD2 forbids) — the card fee is paid out of this margin.
#
# MEASURED on the first real card sale (2026-09-15, $10, a non-EEA card from IM):
#   $10.00 charged → Mollie converts at 0.841 while the mid-market rate was 0.86663
#   (a 3.0 % FX spread, €0.26) → €8.41, fee €0.52 (6.2 %) → €7.88 paid out = $9.10.
#   All-in cost of collecting a dollar: 9.0 %, not the ~4.7 % assumed when 1.15 was set.
#   At 1.30 the sale still nets $1.41 (14 %): break-even margin is 10/9.10 = 1.10.
# Watch the two rails where the cut is bigger than a card's:
#   IAP breaks even at a commission of 1 - 1/1.30 = 23.1 %. Apple's standard 30 % LOSES
#   $0.69 per $10; the Small Business Program's 15 % nets $0.81. Enrolling is therefore a
#   precondition for selling on iOS at this margin, not a nice-to-have.
#   COIN_DISCOUNT_PCT lowers the price but not the cost: at 10 % off, a $5 coin sale nets
#   $4.50 - 5/1.30 = $0.65.
MARGIN=1.30
# What a coin payment (NYM, Bitcoin) costs relative to the card price, as a percentage
# OFF. The same credit for a lower price — never extra credit, which would create
# balances of unequal face value. The saving is real: a coin payment cannot be charged
# back, and a chargeback on an anonymous, instantly-consumed product is always lost,
# fee and spent API value included. 0 switches it off. Not shown in the iOS app.
COIN_DISCOUNT_PCT=10
MIN_CHARGE_SCRAI=1
FREE_TIER_FACTOR=1.0
# Fixed purchase amounts in USD (everyone buys the same — no per-user fingerprint).
# PURCHASE_TIERS=5,10,20,50

# --- payment (dev) ----------------------------------------------------------
# Invoices settle by command instead of by money. NEVER in production; the server
# refuses to boot with it set alongside real BTCPay/Nyx credentials.
# FAKE_PAYMENTS=1

# --- payment: BTCPay ----------------------------------------------------------
# Store ID : from the URL /stores/<HERE>/settings
# API key  : Account -> Manage account -> API keys, with exactly
#            btcpay.store.cancreateinvoice + btcpay.store.canviewinvoices
BTCPAY_URL_TESTNET=https://testnet.demo.btcpayserver.org
BTCPAY_STORE_ID_TESTNET=<testnet store id>
BTCPAY_API_KEY_TESTNET=<testnet store key>
#
# BTCPAY_URL_MAINNET=<mainnet btcpay>
# BTCPAY_STORE_ID_MAINNET=<mainnet store id>
# BTCPAY_API_KEY_MAINNET=<mainnet store key>

# --- payment: NYM / NYX -------------------------------------------------------
# NOTE: TESTNET=0 does NOT switch these over by itself. `net_var` resolves
# _MAINNET → _TESTNET → bare, so a box with only _TESTNET values keeps running against the
# test world while it accepts real money — Mollie worst of all, whose test checkout lets the
# payer pick "paid" for free. The server therefore REFUSES TO BOOT in that state; set the
# _MAINNET variant of every rail you use before flipping the switch.
# TESTNET / sandbox (active) — chain "sandbox", denom unym
# MAINNET (commented out) — chain "nyx"
# The LCD is the validator's /api; the faucet uses the same validator's root as RPC.
NYX_LCD_URL_TESTNET=https://validator-sandbox-1.nymtech.net/api
NYX_RECEIVE_ADDRESS_TESTNET=<sandbox nyx address>
# NYX_LCD_URL_MAINNET=https://api.nymtech.net
# NYX_RECEIVE_ADDRESS_MAINNET=<mainnet nyx address>
# Own price feed instead of the built-in chain (tests): NYX_PRICE_URL=<url>

# ---- OpenAI (Responses API) ---------------------------------------------------------
# Paid models only (no free tier; the OpenAI account is prepaid — set a monthly budget in
# its dashboard). Enable with PROVIDERS containing "openai". Never on a testnet
# server: faucet dollars would buy real OpenAI tokens.
# OPENAI_API_KEY=sk-...
# MODERATION_PREFILTER=1 — run OpenAI's free moderation endpoint on the user's latest
# turn BEFORE the model call and decline flagged input ourselves ("Declined by OpenAI
# (moderation: …)"). 1 = on (default), 0 = off. Only OpenAI-routed chats are checked;
# the prompt goes to OpenAI either way, so it costs privacy nothing extra — only ~0.3 s.
# A moderation outage fails open (the model's own policy check still stands).
MODERATION_PREFILTER=1
# Declines a session may collect per UTC day (any provider's "Declined by …", incl. the
# prefilter) before every further chat of that session is refused until the next day.
# The session's balance stays where it is — unusable for the day, not deleted.
ABUSE_STRIKES_PER_DAY=3
# Salt for the per-day safety identifier sent to OpenAI (sha256(salt|day|session)).
# Unset = random per boot (identifiers then also rotate on restart). Never the raw id.
# ABUSE_SALT=<random string>
# What the app's privacy badge says OpenAI keeps inputs for: 30 (abuse monitoring) or 0
# once the org has Zero Data Retention.
# OPENAI_RETENTION_DAYS=30
# Our cost per web-search tool call (USD); OpenAI lists $10 / 1k calls for reasoning models.
# OPENAI_SEARCH_USD=0.01
# Concurrent OpenAI calls (own pool, so an OpenAI rate limit never holds Gemini's slots).
# MAX_INFLIGHT_OPENAI=16
# Which OpenAI models to offer (comma list). Default: gpt-5.4-nano, gpt-5.4-mini, gpt-5.4 —
# on a TESTNET server (TESTNET=1) only gpt-5.4-nano, since testers pay with faucet
# dollars while OpenAI bills real ones.
# OPENAI_MODELS=gpt-5.4-nano
