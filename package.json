{
  "name": "tokumai",
  "version": "0.5.2",
  "private": true,
  "description": "Anonymer AI-Chat übers Nym-Mixnet — stateless Adapter-Server + Web-Client (murmur)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "nym:install": "tsx src/cli/client.ts install-nym",
    "client": "tsx --env-file-if-exists=.env src/cli/client.ts",
    "client:setup": "tsx --env-file-if-exists=.env src/cli/client.ts setup",
    "client:daemon": "tsx --env-file-if-exists=.env src/cli/client.ts daemon",
    "server": "tsx --env-file=.env src/cli/server.ts run",
    "server:setup": "tsx --env-file-if-exists=.env src/cli/server.ts setup",
    "server:gw": "tsx --env-file-if-exists=.env src/cli/server.ts",
    "issuer": "tsx --env-file-if-exists=.env src/cli/issuer.ts",
    "test": "tsx test/billing.test.ts && tsx test/protocol.test.ts && tsx test/assembler.test.ts && tsx test/blind.test.ts && tsx test/money.test.ts && tsx test/prune.test.ts && tsx test/guard.test.ts",
    "prune:eval": "tsx --env-file=.env scripts/prune-eval.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run typecheck && npm test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:ios": "xcrun simctl boot 'iPhone 17 Pro' 2>/dev/null; open -a Simulator; tauri ios dev 'iPhone 17 Pro'",
    "tauri:build": "tauri build",
    "guard:model": "bash scripts/fetch-guard-model.sh",
    "tauri:dev:smart": "tauri dev --features smart-guard -c src-tauri/tauri.smart.conf.json",
    "tauri:build:smart": "tauri build --features smart-guard -c src-tauri/tauri.smart.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "puppeteer-core": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/tendermint-rpc": "^0.39.0",
    "@noble/curves": "^2.3.0",
    "@tauri-apps/api": "^2.11.1",
    "bip39": "^3.1.0",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tesseract.js": "^7.0.0"
  }
}
