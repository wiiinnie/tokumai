{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ScrambleAI",
  "version": "0.1.0",
  "identifier": "com.scrambleai.app",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:1421",
    "beforeDevCommand": "node scripts/tauri-dev-server.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ScrambleAI",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
